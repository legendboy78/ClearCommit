# --- Required API credentials ---
# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ElevenLabs key — ONLY needed for the voice-CLONING backend (--backend elevenlabs).
# Leave blank to use Groq Orpheus TTS (preset voices, English/Arabic only).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# TTS backend: "groq" (default, no cloning) or "elevenlabs" (clone your voice).
TTS_BACKEND=groq

# Optional: override the temp directory used for intermediate files.
# TMPDIR=/tmp
